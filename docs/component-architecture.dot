digraph component_architecture {
    rankdir=TB
    bgcolor="transparent"
    dpi=96
    pad=0.5
    nodesep=0.6
    ranksep=0.7
    newrank=true

    node [
        fontname="Helvetica"
        fontsize=10
        style="filled,rounded"
        shape=box
        fillcolor="#f5f5f5"
        color="#333333"
        penwidth=1.5
        height=0.5
    ]

    edge [
        fontname="Helvetica"
        fontsize=8
        color="#666666"
        penwidth=1.2
    ]

    subgraph cluster_sp {
        label="dcm-kcli-provider"
        labeljust=l
        fontname="Helvetica,Bold"
        fontsize=13
        style="filled,rounded"
        fillcolor="#e8f0fe"
        color="#4285f4"
        penwidth=2
        margin=20

        subgraph cluster_handlers {
            label="HTTP Handlers"
            labeljust=l
            fontname="Helvetica"
            fontsize=10
            style="filled,rounded,dashed"
            fillcolor="#d2e3fc"
            color="#4285f4"
            penwidth=1

            vm_handler [
                label="VM Handler\n/api/v1alpha1/vms"
                fillcolor="#c6dafc"
            ]
            cluster_handler [
                label="Cluster Handler\n/api/v1alpha1/clusters"
                fillcolor="#c6dafc"
            ]
            health_handler [
                label="Health Handler\n/health"
                fillcolor="#c6dafc"
            ]
        }

        kweb_client [
            label="kweb HTTP Client\nerror normalization · retry · rate limiting"
            fillcolor="#aecbfa"
            color="#1a73e8"
            penwidth=2
        ]

        store [
            label="Persistent State Store (bbolt)\ndcm-instance-id ↔ kcli name"
            shape=cylinder
            fillcolor="#aecbfa"
            color="#1a73e8"
            penwidth=2
        ]

        subgraph cluster_infra {
            label="Infrastructure Clients"
            labeljust=l
            fontname="Helvetica"
            fontsize=10
            style="filled,rounded,dashed"
            fillcolor="#d2e3fc"
            color="#4285f4"
            penwidth=1

            spm_client [
                label="SPM Client\n(dual registration)"
                fillcolor="#c6dafc"
            ]
            monitor [
                label="Status Monitor\n(poller + debounce)"
                fillcolor="#c6dafc"
            ]
            nats_client [
                label="NATS Client\n(CloudEvents)"
                fillcolor="#c6dafc"
            ]
        }
    }

    // External systems
    dcm_spm [
        label="DCM SP Manager"
        fillcolor="#e6f4ea"
        color="#34a853"
        penwidth=2
    ]
    kweb [
        label="kweb (kcli)\nport 9000"
        fillcolor="#fce8e6"
        color="#ea4335"
        penwidth=2
    ]
    nats [
        label="NATS Server"
        fillcolor="#fef7e0"
        color="#f9ab00"
        penwidth=2
    ]

    // Internal edges — handlers to kweb client
    vm_handler -> kweb_client
    cluster_handler -> kweb_client
    health_handler -> kweb_client

    kweb_client -> store [dir=both style=dashed]

    // Force vertical ordering: store above infra clients
    store -> monitor [style=invis]
    store -> spm_client [style=invis]

    // Monitor edges — constraint=false to keep monitor in infra row
    monitor -> kweb_client [constraint=false]
    monitor -> store [dir=both style=dashed constraint=false]
    monitor -> nats_client [constraint=false]

    // External edges
    spm_client -> dcm_spm [label="  register  " fontcolor="#34a853"]
    kweb_client -> kweb [label="  HTTP  " fontcolor="#ea4335" constraint=false]
    monitor -> kweb [label="  poll  " fontcolor="#ea4335" style=dashed weight=10]
    nats_client -> nats [label="  status events  " fontcolor="#f9ab00"]

    // Keep nats_client in the same row as monitor/spm_client
    { rank=same; spm_client; monitor; nats_client }
}
