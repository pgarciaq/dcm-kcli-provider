digraph architecture_overview {
    rankdir=LR
    bgcolor="transparent"
    dpi=96
    pad=0.4

    node [
        fontname="Helvetica"
        fontsize=11
        style="filled,rounded"
        shape=box
        fillcolor="#f5f5f5"
        color="#333333"
        penwidth=1.5
    ]

    edge [
        fontname="Helvetica"
        fontsize=9
        color="#666666"
        penwidth=1.2
    ]

    subgraph cluster_sp {
        label="dcm-kcli-provider (Go)"
        labeljust=l
        fontname="Helvetica,Bold"
        fontsize=12
        style="filled,rounded"
        fillcolor="#e8f0fe"
        color="#4285f4"
        penwidth=2

        server [
            label="OpenAPI Server\n(Chi router)"
            fillcolor="#c6dafc"
        ]
        spm_client [
            label="SPM Client\n(registration)"
            fillcolor="#c6dafc"
        ]
        kweb_client [
            label="kweb HTTP Client\n(error normalization)"
            fillcolor="#c6dafc"
        ]
        nats_client [
            label="NATS Publisher\n(CloudEvents)"
            fillcolor="#c6dafc"
        ]
        store [
            label="State Store\n(bbolt)"
            shape=cylinder
            fillcolor="#c6dafc"
        ]
    }

    subgraph cluster_external {
        rank=same
        label=""
        style=invis

        kweb [
            label="kweb\n(kcli HTTP API)\nport 9000"
            fillcolor="#fce8e6"
            color="#ea4335"
        ]
        dcm [
            label="DCM\nControl Plane"
            fillcolor="#e6f4ea"
            color="#34a853"
        ]
        nats [
            label="NATS\nServer"
            fillcolor="#fef7e0"
            color="#f9ab00"
        ]
        hypervisor [
            label="libvirt / KVM\n(or other backend)"
            shape=box3d
            fillcolor="#f3e8fd"
            color="#9334e6"
        ]
    }

    server -> kweb_client [style=invis]
    kweb_client -> kweb [label="  HTTP  " fontcolor="#ea4335"]
    kweb -> hypervisor [label="  libvirt API  " fontcolor="#9334e6"]
    spm_client -> dcm [label="  register  " fontcolor="#34a853"]
    nats_client -> nats [label="  status events  " fontcolor="#f9ab00"]
    dcm -> server [label="  provision / health  " fontcolor="#4285f4"]
    kweb_client -> store [dir=both style=dashed color="#999999" label="  id ↔ name  "]
}
