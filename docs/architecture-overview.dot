digraph architecture_overview {
    bgcolor="transparent"
    dpi=96
    pad=0.5
    nodesep=0.7
    ranksep=0.8
    newrank=true

    node [
        fontname="Helvetica"
        fontsize=11
        style="filled,rounded"
        shape=box
        fillcolor="#f5f5f5"
        color="#333333"
        penwidth=1.5
    ]

    edge [
        fontname="Helvetica"
        fontsize=9
        color="#666666"
        penwidth=1.2
    ]

    // External: left side
    nats [
        label="NATS\nServer"
        fillcolor="#fef7e0"
        color="#f9ab00"
        penwidth=2
    ]
    dcm [
        label="DCM\nControl Plane"
        fillcolor="#e6f4ea"
        color="#34a853"
        penwidth=2
    ]

    // SP box
    subgraph cluster_sp {
        label="dcm-kcli-provider (Go)"
        labeljust=l
        fontname="Helvetica,Bold"
        fontsize=12
        style="filled,rounded"
        fillcolor="#e8f0fe"
        color="#4285f4"
        penwidth=2

        nats_client [
            label="NATS Publisher  (CloudEvents)"
            fillcolor="#c6dafc"
        ]
        server [
            label="OpenAPI Server  (Chi router)"
            fillcolor="#c6dafc"
        ]
        spm_client [
            label="SPM Client  (registration)"
            fillcolor="#c6dafc"
        ]
        kweb_client [
            label="kweb HTTP Client  (error normalization)"
            fillcolor="#c6dafc"
        ]
        store [
            label="State Store  (bbolt)"
            shape=cylinder
            fillcolor="#c6dafc"
        ]

        // Vertical stack inside SP
        nats_client -> server -> spm_client -> kweb_client -> store [style=invis]
    }

    // External: right side
    kweb [
        label="kweb\n(kcli HTTP API)\nport 9000"
        fillcolor="#fce8e6"
        color="#ea4335"
        penwidth=2
    ]
    hypervisor [
        label="libvirt / KVM\n(or other backend)"
        shape=box3d
        fillcolor="#f3e8fd"
        color="#9334e6"
        penwidth=2
    ]

    // Row alignment
    { rank=same; nats; nats_client }
    { rank=same; dcm; server; kweb }
    { rank=same; kweb_client; hypervisor }

    // Left-side edges
    nats_client -> nats [label="  status events  " fontcolor="#f9ab00"]
    dcm -> server [label="  provision / health  " fontcolor="#4285f4" dir=both]
    spm_client -> dcm [label="register  " fontcolor="#34a853" constraint=false]

    // Right-side edges
    kweb_client -> kweb [label="  HTTP  " fontcolor="#ea4335" constraint=false]
    kweb -> hypervisor [label="  libvirt API  " fontcolor="#9334e6"]

    // Internal dashed edge
    kweb_client -> store [dir=both style=dashed color="#999999" label="id ↔ name"]
}
